// InsureFlow — enterprise data layer (multi-tenant + RBAC + audit)
// Consumido por apps/api via Prisma Client gerado neste pacote

generator client {
  provider = "prisma-client-js"
  // Cliente gerado no node_modules da raiz para resolver com @prisma/client hoisted (npm workspaces)
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  archived
}

/// Escopo de visibilidade de registros (ownership)
enum DataScope {
  own
  team
  tenant
  shared
}

enum LeadSharePermission {
  read
  comment
}

enum BusinessUnitType {
  INSURANCE
  REAL_ESTATE
}

enum MessageChannel {
  WHATSAPP
  EMAIL
}

enum ReactivationChannel {
  WHATSAPP
  EMAIL
  BOTH
}

enum CrossSellStatus {
  PENDING
  CONTACTED
  CONVERTED
  DISMISSED
}

enum ReactivationDispatchStatus {
  sent
  failed
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Status comercial da fila de renovação (independente de PolicyRenewalStatus da apólice)
enum CommercialRenewalStatus {
  ACTIVE
  RENEWAL_PENDING
  RENEWAL_IN_PROGRESS
  RENEWED
  LOST
}

enum CommunicationProviderKind {
  INTERNAL
  EVOLUTION
  META
  ZAPI
  TWILIO
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationPurpose {
  REACTIVATION
  FOLLOW_UP
  RENEWAL
  CROSS_SELL
  MANUAL
}

enum CommunicationStatus {
  queued
  sent
  delivered
  read
  failed
  replied
}

enum OpportunityType {
  AUTO_INSURANCE
  LIFE_INSURANCE
  HEALTH_INSURANCE
  HOME_INSURANCE
  PROPERTY_BUY
  PROPERTY_SELL
  PROPERTY_RENT
}

enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
  DISMISSED
}

enum OpportunityScore {
  LOW
  MEDIUM
  HIGH
}

enum DealSourceType {
  LEAD
  RENEWAL
  CROSS_SELL
  MANUAL
  REACTIVATION
}

enum DealScore {
  LOW
  MEDIUM
  HIGH
}

enum PipelineAlertTarget {
  OWNER
  MANAGER
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PropertyPurpose {
  SALE
  RENT
  SALE_AND_RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  OTHER
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum PersonKind {
  INDIVIDUAL
  COMPANY
}

enum PropertyFeatureValueType {
  BOOLEAN
  TEXT
  NUMBER
}

enum OpportunitySource {
  ENGINE
  MANUAL
  CROSS_SELL
  PROPERTY
  RENEWAL
}

/// Organização (tenant) — isolamento lógico de dados
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(active)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                    User[]
  roles                    Role[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  deals                    Deal[]
  customers                Customer[]
  leads                    Lead[]
  policies                 Policy[]
  questionnaireTemplates   QuestionnaireTemplate[]
  questionnaireFields      QuestionnaireField[]
  questionnaireSubmissions QuestionnaireSubmission[]
  activities               Activity[]
  teams                    Team[]
  quoteComparisons         QuoteComparison[]
  businessUnits            BusinessUnit[]
  leadReactivationSetting  LeadReactivationSetting?
  messageTemplates         MessageTemplate[]
  crossSellOpportunities   CrossSellOpportunity[]
  leadReactivationLogs     LeadReactivationLog[]
  leadLossReasons          LeadLossReason[]
  leadFollowUps            LeadFollowUp[]
  policyRenewals           PolicyRenewal[]
  communicationLogs        CommunicationLog[]
  communicationProviderConfig CommunicationProviderConfig?
  opportunities            Opportunity[]
  businessUnitPipelines    BusinessUnitPipeline[]
  dealStageHistories       DealStageHistory[]
  salesTargets             SalesTarget[]
  salesCommissions         SalesCommission[]
  commissionRules          CommissionRule[]
  properties               Property[]
  propertyImages           PropertyImage[]
  propertyLeads            PropertyLead[]
  persons                  Person[]
  propertyOwners           PropertyOwner[]
  propertyFeatureDefinitions PropertyFeatureDefinition[]
  propertyFeatures         PropertyFeature[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  initials     String
  title        String    @default("")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles                       UserRole[]
  auditLogs                       AuditLog[]
  refreshTokens                   RefreshToken[]
  activities                      Activity[]
  brokeredPolicies                Policy[]                  @relation("PolicyBroker")
  primaryTeamId                   String?                   @map("primary_team_id")
  primaryTeam                     Team?                     @relation("UserPrimaryTeam", fields: [primaryTeamId], references: [id], onDelete: SetNull)
  teamMemberships                 TeamMember[]
  ownedLeads                      Lead[]                    @relation("LeadOwner")
  ownedDeals                      Deal[]                    @relation("DealOwner")
  leadsSharedWith                 LeadShare[]               @relation("LeadSharedWith")
  leadsSharedBy                   LeadShare[]               @relation("LeadSharedBy")
  quoteComparisons                QuoteComparison[]         @relation("QuoteComparisonAssignee")
  updatedQuestionnaireSubmissions QuestionnaireSubmission[] @relation("QuestionnaireSubmissionUpdatedBy")
  createdLeadFollowUps            LeadFollowUp[]            @relation("FollowUpCreatedBy")
  assignedLeadFollowUps           LeadFollowUp[]            @relation("FollowUpAssignee")
  assignedPolicyRenewals          PolicyRenewal[]           @relation("PolicyRenewalAssignee")
  communicationLogs               CommunicationLog[]        @relation("CommunicationPerformedBy")
  assignedOpportunities           Opportunity[]             @relation("OpportunityAssignee")
  ownedCustomers                  Customer[]                @relation("CustomerOwner")
  dealStageChanges                DealStageHistory[]        @relation("DealStagePerformedBy")
  salesTargets                    SalesTarget[]
  salesCommissions                SalesCommission[]
  createdProperties               Property[]                @relation("PropertyCreatedBy")
  businessUnits                   UserBusinessUnit[]
  currentBusinessUnitId           String?                   @map("current_business_unit_id")
  currentBusinessUnit             BusinessUnit?             @relation("UserActiveBusinessUnit", fields: [currentBusinessUnitId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([currentBusinessUnitId])
  @@map("users")
}

/// Permissão atômica (ex.: crm:view) — catálogo global
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Papel por tenant (slug único dentro do tenant)
model Role {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?
  isSystem         Boolean   @default(false)
  defaultDataScope DataScope @default(own) @map("default_data_scope")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Team {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  primaryUsers User[]       @relation("UserPrimaryTeam")
  ownedLeads   Lead[]
  salesTargets SalesTarget[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("teams")
}

model TeamMember {
  teamId   String
  userId   String
  isLead   Boolean  @default(false)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model LeadShare {
  id               String              @id @default(cuid())
  tenantId         String
  leadId           String
  lead             Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sharedWithUserId String              @map("shared_with_user_id")
  sharedWithUser   User                @relation("LeadSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedByUserId   String              @map("shared_by_user_id")
  sharedByUser     User                @relation("LeadSharedBy", fields: [sharedByUserId], references: [id], onDelete: Restrict)
  permission       LeadSharePermission @default(read)
  expiresAt        DateTime?           @map("expires_at")
  revokedAt        DateTime?           @map("revoked_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  @@unique([leadId, sharedWithUserId])
  @@index([tenantId, sharedWithUserId])
  @@index([leadId])
  @@map("lead_shares")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([tenantId, expiresAt])
  @@map("refresh_tokens")
}

enum AuditSeverity {
  info
  warning
  critical
}

enum PolicyStatus {
  pending
  active
  cancelled
  expired
  lapsed
}

enum PolicyRenewalStatus {
  pending
  in_progress
  renewed
  lapsed
  cancelled
}

model AuditLog {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  severity   AuditSeverity @default(info)
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model Deal {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  company       String
  value         Decimal   @db.Decimal(14, 2)
  stage         String    @default("novo")
  status        String    @default("open")
  pipelineOrder Float     @default(0)
  assignedTo    String?
  ownerUserId   String?   @map("owner_user_id")
  ownerUser     User?     @relation("DealOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation("DealCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  businessUnitId String?       @map("business_unit_id")
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  pipelineId     String?       @map("pipeline_id")
  pipeline       BusinessUnitPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  sourceType     DealSourceType @default(MANUAL) @map("source_type")
  sourceId       String?       @map("source_id")
  score          DealScore     @default(LOW)
  productType    String?       @map("product_type")
  stageEnteredAt DateTime      @default(now()) @map("stage_entered_at")
  wonAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stageHistory             DealStageHistory[]
  convertedLead            Lead?                     @relation("LeadConvertedDeal")
  sourcedCustomer          Customer?                 @relation("CustomerSourceDeal")
  questionnaireSubmissions QuestionnaireSubmission[]
  activities               Activity[]
  policies                 Policy[]
  quoteComparisons         QuoteComparison[]
  policyRenewals           PolicyRenewal[]
  commissions              SalesCommission[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, stage, pipelineOrder])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, customerId])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, sourceType])
  @@index([tenantId, score])
  @@index([tenantId, productType])
  @@index([tenantId, stageEnteredAt])
  @@map("deals")
}

model Customer {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            String
  name            String
  document        String
  email           String?
  phone           String?
  /// Conta cadastral: active | inactive | archived
  status          String    @default("active")
  /// Lifecycle operacional pós-venda (separado do pipeline comercial)
  lifecycleStage  String    @default("won")
  sourceDealId    String?   @unique
  sourceDeal      Deal?     @relation("CustomerSourceDeal", fields: [sourceDealId], references: [id], onDelete: SetNull)
  companyName     String?
  renewalDate     DateTime?
  renewalStatus   String?
  renewalPipeline String?
  businessUnitId     String?       @map("business_unit_id")
  businessUnit       BusinessUnit? @relation("CustomerOriginBusinessUnit", fields: [businessUnitId], references: [id], onDelete: SetNull)
  interestCategories String[]      @default([]) @map("interest_categories")
  ownerUserId        String?       @map("owner_user_id")
  ownerUser          User?         @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deals                    Deal[]                    @relation("DealCustomer")
  opportunities            Opportunity[]
  businessUnits            CustomerBusinessUnit[]
  crossSellOpportunities   CrossSellOpportunity[]
  policies                 Policy[]
  questionnaireSubmissions QuestionnaireSubmission[]
  activities               Activity[]
  quoteComparisons         QuoteComparison[]
  policyRenewals           PolicyRenewal[]
  communicationLogs        CommunicationLog[]
  persons                  Person[]

  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, renewalDate])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, ownerUserId])
  @@map("customers")
}

/// Apólice / contrato de seguro vinculado ao cliente (pós-venda)
model Policy {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  insurer      String
  policyNumber String
  productLine  String
  modality     String?

  premiumValue    Decimal  @db.Decimal(14, 2)
  commissionValue Decimal? @db.Decimal(14, 2)

  issuedAt      DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  status        PolicyStatus         @default(pending)
  renewalStatus PolicyRenewalStatus?

  brokerUserId String?
  brokerUser   User?   @relation("PolicyBroker", fields: [brokerUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  commercialRenewals PolicyRenewal[]

  @@unique([tenantId, policyNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, dealId])
  @@index([tenantId, status])
  @@index([tenantId, renewalStatus])
  @@index([tenantId, effectiveTo])
  @@index([tenantId, brokerUserId])
  @@index([tenantId, insurer])
  @@map("policies")
}

model Lead {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  company       String?
  source        String?
  documentType  String?
  document      String?
  status        String    @default("new")
  notes         String?
  assignedTo    String?
  ownerUserId   String?   @map("owner_user_id")
  ownerUser     User?     @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerTeamId   String?   @map("owner_team_id")
  ownerTeam     Team?     @relation(fields: [ownerTeamId], references: [id], onDelete: SetNull)
  lastContactAt DateTime?
  lastInteractionAt DateTime? @map("last_interaction_at")
  businessUnitId    String?   @map("business_unit_id")
  businessUnit      BusinessUnit? @relation("LeadOriginBusinessUnit", fields: [businessUnitId], references: [id], onDelete: SetNull)
  interestCategories String[] @default([]) @map("interest_categories")
  lostReason        String?   @map("lost_reason")
  lossReasonId      String?   @map("loss_reason_id")
  configuredLossReason LeadLossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  lostAt            DateTime? @map("lost_at")
  reactivationEnabled Boolean @default(true) @map("reactivation_enabled")
  reactivationDays    Int?    @map("reactivation_days")
  reactivationAttempts Int    @default(0) @map("reactivation_attempts")
  nextReactivationAt  DateTime? @map("next_reactivation_at")
  lastReactivatedAt   DateTime? @map("last_reactivated_at")
  dealId        String?   @unique
  deal          Deal?     @relation("LeadConvertedDeal", fields: [dealId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  questionnaireSubmissions QuestionnaireSubmission[]
  activities               Activity[]
  shares                   LeadShare[]
  quoteComparisons         QuoteComparison[]
  businessUnits            LeadBusinessUnit[]
  reactivationLogs         LeadReactivationLog[]
  followUps                LeadFollowUp[]
  communicationLogs        CommunicationLog[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([tenantId, assignedTo])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, ownerTeamId])
  @@index([tenantId, createdAt])
  @@index([tenantId, document])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, status, nextReactivationAt])
  @@index([tenantId, lossReasonId])
  @@map("leads")
}

/// Interação humana registrada no CRM (ligações, notas, follow-up, etc.)
model Activity {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                 String
  /// Status operacional: pending | completed | cancelled
  status               String    @default("pending")
  subject              String
  description          String?
  outcome              String?
  /// Evento operacional pós-venda (deal_won, policy_issued, renewal, claim, …)
  operationalEventKind String?
  occurredAt           DateTime
  nextFollowUpAt       DateTime?
  leadId               String?
  lead                 Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId               String?
  deal                 Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  policyId             String?
  policy               Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  performedById        String
  performedBy          User      @relation(fields: [performedById], references: [id], onDelete: Restrict)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, occurredAt])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, type])
  @@index([tenantId, leadId])
  @@index([tenantId, dealId])
  @@index([tenantId, customerId])
  @@index([tenantId, policyId])
  @@map("activities")
}

enum QuestionnaireTemplateStatus {
  draft
  active
  archived
}

enum QuestionnaireFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  EMAIL
  PHONE
  CURRENCY
  FILE
}

enum QuestionnaireOrigin {
  WHATSAPP
  INSTAGRAM
  SITE
  INTERNAL
  PHONE
  INDICATION
}

enum QuestionnaireSubmissionMode {
  INTERNAL
  EXTERNAL
}

enum QuestionnaireSubmissionStatus {
  draft
  submitted
  reviewed
  archived
}

model QuestionnaireTemplate {
  id          String                      @id @default(cuid())
  tenantId    String
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      QuestionnaireTemplateStatus @default(draft)
  version     Int                         @default(1)
  settings    Json                        @default("{}")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  fields      QuestionnaireField[]
  submissions QuestionnaireSubmission[]

  @@unique([tenantId, name, version])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("questionnaire_templates")
}

model QuestionnaireField {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestionnaireTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        QuestionnaireFieldType
  required    Boolean                @default(false)
  order       Int                    @default(0)
  placeholder String?
  helpText    String?
  options     Json?
  validation  Json?
  settings    Json                   @default("{}")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([templateId, key])
  @@index([tenantId])
  @@index([templateId])
  @@index([tenantId, templateId])
  @@map("questionnaire_fields")
}

model QuestionnaireSubmission {
  id          String                        @id @default(cuid())
  tenantId    String
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestionnaireTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  mode        QuestionnaireSubmissionMode   @default(INTERNAL)
  origin      QuestionnaireOrigin           @default(INTERNAL)
  status      QuestionnaireSubmissionStatus @default(draft)
  answers     Json                          @default("{}")
  metadata    Json?
  leadId      String?
  lead        Lead?                         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?                         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  submittedAt DateTime?
  updatedById String?                       @map("updated_by_id")
  updatedBy   User?                         @relation("QuestionnaireSubmissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  quoteComparisons QuoteComparison[]

  @@index([tenantId])
  @@index([tenantId, templateId])
  @@index([tenantId, status])
  @@index([tenantId, origin])
  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, dealId])
  @@index([tenantId, updatedById])
  @@index([tenantId, createdAt])
  @@map("questionnaire_submissions")
}

/// Fluxo comercial de cotação (agrupa comparativo multi-seguradora)
enum QuoteWorkflowStatus {
  received
  in_analysis
  quote_created
  quote_sent
  negotiation
  closed_won
  closed_lost
}

enum QuoteLineStatus {
  draft
  quoted
  sent
  selected
  rejected
  expired
}

enum ProposalStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
}

model QuoteComparison {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String?
  workflowStatus  QuoteWorkflowStatus      @default(received)
  leadId          String?
  lead            Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?                    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  submissionId    String?
  submission      QuestionnaireSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?                    @relation("QuoteComparisonAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           String?
  selectedQuoteId String?                  @unique
  selectedQuote   Quote?                   @relation("SelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  closedAt        DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  quotes    Quote[]
  proposals Proposal[]

  @@index([tenantId])
  @@index([tenantId, workflowStatus])
  @@index([tenantId, leadId])
  @@index([tenantId, dealId])
  @@index([tenantId, customerId])
  @@index([tenantId, submissionId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, createdAt])
  @@map("quote_comparisons")
}

/// Cotação individual por seguradora (linha do comparativo)
model Quote {
  id             String          @id @default(cuid())
  tenantId       String
  comparisonId   String
  comparison     QuoteComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  insurer        String
  product        String?
  plan           String?
  premiumValue   Decimal         @db.Decimal(14, 2)
  franchiseValue Decimal?        @db.Decimal(14, 2)
  coverages      Json            @default("[]")
  assistance     String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  status         QuoteLineStatus @default(draft)
  observations   String?
  attachments    Json            @default("[]")
  externalSource String          @default("manual")
  externalRef    String?
  isSelected     Boolean         @default(false)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  selectedForComparison QuoteComparison? @relation("SelectedQuote")
  proposals             Proposal[]

  @@index([tenantId])
  @@index([tenantId, comparisonId])
  @@index([tenantId, insurer])
  @@index([tenantId, status])
  @@map("quotes")
}

/// Proposta comercial derivada do comparativo
model Proposal {
  id                  String          @id @default(cuid())
  tenantId            String
  comparisonId        String
  comparison          QuoteComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  quoteId             String?
  quote               Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status              ProposalStatus  @default(draft)
  title               String?
  value               Decimal?        @db.Decimal(14, 2)
  sentAt              DateTime?
  viewedAt            DateTime?
  respondedAt         DateTime?
  expiresAt           DateTime?
  expiredAt           DateTime?
  notes               String?
  pdfStorageKey       String?
  pdfGeneratedAt      DateTime?
  pdfVersion          Int             @default(0)
  /// Preparado para integração futura com assinatura eletrônica
  signatureProvider   String?
  signatureExternalId String?
  signatureStatus     String?
  publicViewToken     String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, comparisonId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("proposals")
}

/// Unidade de negócio do grupo (corretora, imobiliária, futuras empresas)
model BusinessUnit {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  type      BusinessUnitType
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  originLeads      Lead[]                 @relation("LeadOriginBusinessUnit")
  leadLinks        LeadBusinessUnit[]
  originCustomers  Customer[]             @relation("CustomerOriginBusinessUnit")
  customerLinks    CustomerBusinessUnit[]
  deals            Deal[]
  messageTemplates MessageTemplate[]
  leadLossReasons  LeadLossReason[]
  leadFollowUps    LeadFollowUp[]
  policyRenewals   PolicyRenewal[]
  opportunities    Opportunity[]
  pipeline         BusinessUnitPipeline?
  userLinks        UserBusinessUnit[]
  activeUsers      User[]             @relation("UserActiveBusinessUnit")
  salesTargets     SalesTarget[]
  salesCommissions SalesCommission[]
  commissionRules  CommissionRule[]
  properties       Property[]
  propertyLeads    PropertyLead[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("business_units")
}

model UserBusinessUnit {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, businessUnitId])
  @@index([businessUnitId])
  @@index([userId])
  @@map("user_business_units")
}

model LeadBusinessUnit {
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  isOrigin       Boolean      @default(false) @map("is_origin")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([leadId, businessUnitId])
  @@index([businessUnitId])
  @@map("lead_business_units")
}

model CustomerBusinessUnit {
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  isOrigin       Boolean      @default(false) @map("is_origin")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([customerId, businessUnitId])
  @@index([businessUnitId])
  @@map("customer_business_units")
}

model BusinessUnitPipeline {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId String       @unique @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stages PipelineStage[]
  deals  Deal[]

  @@index([tenantId])
  @@map("business_unit_pipelines")
}

model PipelineStage {
  id          String               @id @default(cuid())
  pipelineId  String               @map("pipeline_id")
  pipeline    BusinessUnitPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  slug        String
  label       String
  sortOrder   Int                  @map("sort_order")
  maxDays     Int?                 @map("max_days")
  alertTarget PipelineAlertTarget? @map("alert_target")
  color       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([pipelineId, slug])
  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

model DealStageHistory {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealId        String    @map("deal_id")
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage     String?   @map("from_stage")
  toStage       String    @map("to_stage")
  pipelineId    String?   @map("pipeline_id")
  enteredAt     DateTime  @default(now()) @map("entered_at")
  exitedAt      DateTime? @map("exited_at")
  durationMs    Int?      @map("duration_ms")
  performedById String?   @map("performed_by_id")
  performedBy   User?     @relation("DealStagePerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([tenantId, dealId])
  @@index([tenantId, enteredAt])
  @@index([dealId, enteredAt])
  @@map("deal_stage_history")
}

model SalesTarget {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId   String?  @map("business_unit_id")
  businessUnit     BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  userId           String?  @map("user_id")
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  teamId           String?  @map("team_id")
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  month            Int
  year             Int
  targetDeals      Int      @default(0) @map("target_deals")
  targetRevenue    Decimal  @default(0) @map("target_revenue") @db.Decimal(14, 2)
  achievedDeals    Int      @default(0) @map("achieved_deals")
  achievedRevenue  Decimal  @default(0) @map("achieved_revenue") @db.Decimal(14, 2)
  /// tenant + BU + user + team coalescidos — evita duplicidade com NULLs
  scopeKey         String   @map("scope_key")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, scopeKey, month, year])
  @@index([tenantId, year, month])
  @@index([tenantId, userId])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, teamId])
  @@map("sales_targets")
}

model SalesCommission {
  id                    String           @id @default(cuid())
  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealId                String           @unique @map("deal_id")
  deal                  Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId                String?          @map("user_id")
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessUnitId        String?          @map("business_unit_id")
  businessUnit          BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  commissionPercentage  Decimal          @map("commission_percentage") @db.Decimal(6, 2)
  commissionValue       Decimal          @map("commission_value") @db.Decimal(14, 2)
  status                CommissionStatus @default(PENDING)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@index([tenantId, businessUnitId])
  @@map("sales_commissions")
}

model CommissionRule {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId        String        @map("business_unit_id")
  businessUnit          BusinessUnit  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  productType           String        @map("product_type")
  commissionPercentage  Decimal       @map("commission_percentage") @db.Decimal(6, 2)
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([tenantId, businessUnitId, productType])
  @@index([tenantId, isActive])
  @@map("commission_rules")
}

model LeadReactivationSetting {
  id           String              @id @default(cuid())
  tenantId     String              @unique
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled      Boolean             @default(false)
  idleDays     Int                 @default(30) @map("idle_days")
  maxAttempts  Int                 @default(3) @map("max_attempts")
  channel      ReactivationChannel @default(WHATSAPP)
  templateId   String?             @map("template_id")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("lead_reactivation_settings")
}

model MessageTemplate {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId String?        @map("business_unit_id")
  businessUnit   BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  name           String
  channel        MessageChannel
  content        String
  active         Boolean        @default(true)
  kind           String         @default("reactivation")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reactivationLogs  LeadReactivationLog[]
  communicationLogs CommunicationLog[]

  @@index([tenantId])
  @@index([tenantId, channel])
  @@index([tenantId, active])
  @@index([tenantId, kind])
  @@map("message_templates")
}

model CrossSellOpportunity {
  id                     String          @id @default(cuid())
  tenantId               String
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originCategory         String          @map("origin_category")
  suggestedCategory      String          @map("suggested_category")
  status                 CrossSellStatus @default(PENDING)
  convertedDealId        String?         @map("converted_deal_id")
  convertedRevenue       Decimal?        @map("converted_revenue") @db.Decimal(14, 2)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([customerId, originCategory, suggestedCategory])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("cross_sell_opportunities")
}

model LeadReactivationLog {
  id            String                     @id @default(cuid())
  tenantId      String
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel       MessageChannel
  templateId    String?
  template      MessageTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  content       String
  attemptNumber Int                        @map("attempt_number")
  status        ReactivationDispatchStatus @default(sent)
  sentAt        DateTime                   @default(now()) @map("sent_at")

  @@index([tenantId, sentAt])
  @@index([tenantId, leadId])
  @@map("lead_reactivation_logs")
}

/// Motivo de perda configurável por tenant (não substitui `leads.lost_reason`)
model LeadLossReason {
  id                   String        @id @default(cuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId       String?       @map("business_unit_id")
  businessUnit         BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  name                 String
  description          String?
  isActive             Boolean       @default(true) @map("is_active")
  reactivationEnabled  Boolean       @default(true) @map("reactivation_enabled")
  reactivationDays     Int           @default(30) @map("reactivation_days")
  maxAttempts          Int           @default(3) @map("max_attempts")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  leads Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, businessUnitId])
  @@map("lead_loss_reasons")
}

model LeadFollowUp {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime       @map("scheduled_at")
  type             FollowUpType
  status           FollowUpStatus @default(PENDING)
  notes            String?
  createdById      String         @map("created_by")
  createdBy        User           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedUserId   String?        @map("assigned_user_id")
  assignedUser     User?          @relation("FollowUpAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  businessUnitId   String?        @map("business_unit_id")
  businessUnit     BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  alertedAt        DateTime?      @map("alerted_at")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, leadId])
  @@index([tenantId, businessUnitId])
  @@map("lead_follow_ups")
}

/// Fila comercial de renovação (não altera Policy.status / Policy.renewalStatus)
model PolicyRenewal {
  id                    String                   @id @default(cuid())
  tenantId              String
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String                   @map("client_id")
  customer              Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyId              String?                  @map("policy_id")
  policy                Policy?                  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyNumber          String                   @map("policy_number")
  insurer               String
  product               String
  startDate             DateTime                 @map("start_date")
  endDate               DateTime                 @map("end_date")
  renewalDate           DateTime                 @map("renewal_date")
  status                CommercialRenewalStatus  @default(ACTIVE)
  assignedUserId        String?                  @map("assigned_user_id")
  assignedUser          User?                    @relation("PolicyRenewalAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  businessUnitId        String?                  @map("business_unit_id")
  businessUnit          BusinessUnit?            @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  dealId                String?                  @map("deal_id")
  deal                  Deal?                    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  taskCreatedAt         DateTime?                @map("task_created_at")
  reminderSentAt        DateTime?                @map("reminder_sent_at")
  opportunityCreatedAt  DateTime?                @map("opportunity_created_at")
  convertedRevenue      Decimal?                 @map("converted_revenue") @db.Decimal(14, 2)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([tenantId, status, renewalDate])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, policyId])
  @@map("policy_renewals")
}

/// Provider ativo do tenant. Evolution: credenciais e status em `settings` JSON.
model CommunicationProviderConfig {
  id        String                     @id @default(cuid())
  tenantId  String                     @unique
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      CommunicationProviderKind  @default(INTERNAL)
  enabled   Boolean                    @default(true)
  settings  Json                       @default("{}")
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@map("communication_provider_configs")
}

model CommunicationLog {
  id             String                   @id @default(cuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider       CommunicationProviderKind
  channel        MessageChannel
  direction      CommunicationDirection   @default(OUTBOUND)
  purpose        CommunicationPurpose
  status         CommunicationStatus      @default(queued)
  leadId         String?                  @map("lead_id")
  lead           Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId     String?                  @map("customer_id")
  customer       Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  templateId     String?                  @map("template_id")
  template       MessageTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  performedById  String?                  @map("performed_by_id")
  performedBy    User?                    @relation("CommunicationPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  to             String
  content        String
  externalId     String?                  @map("external_id")
  messageId      String?                  @map("message_id")
  errorMessage   String?                  @map("error_message")
  replyContent   String?                  @map("reply_content")
  metadata       Json                     @default("{}")
  sentAt         DateTime?                @map("sent_at")
  deliveredAt    DateTime?                @map("delivered_at")
  readAt         DateTime?                @map("read_at")
  repliedAt      DateTime?                @map("replied_at")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, purpose])
  @@index([tenantId, provider])
  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, externalId])
  @@index([tenantId, messageId])
  @@map("communication_logs")
}

model Opportunity {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String             @map("customer_id")
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessUnitId   String?            @map("business_unit_id")
  businessUnit     BusinessUnit?      @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  type             OpportunityType
  status           OpportunityStatus  @default(OPEN)
  source           OpportunitySource  @default(ENGINE)
  score            OpportunityScore   @default(MEDIUM)
  originType       String?            @map("origin_type")
  assignedUserId   String?            @map("assigned_user_id")
  assignedUser     User?              @relation("OpportunityAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  estimatedValue   Decimal?           @map("estimated_value") @db.Decimal(14, 2)
  convertedDealId  String?            @map("converted_deal_id")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([customerId, type, originType])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, assignedUserId])
  @@map("opportunities")
}

/// Imóvel de catálogo (independente de Customer360Property / Deal / Opportunity)
model Property {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId String          @map("business_unit_id")
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  slug           String
  title          String
  description    String?
  purpose        PropertyPurpose
  type           PropertyType    @default(OTHER)
  city           String
  neighborhood   String?         @map("neighborhood")
  address        String?
  state          String?
  postalCode     String?         @map("postal_code")
  price          Decimal         @db.Decimal(14, 2)
  areaM2         Decimal?        @map("area_m2") @db.Decimal(10, 2)
  bedrooms       Int?
  bathrooms      Int?
  parkingSpots   Int?            @map("parking_spots")
  featured       Boolean         @default(false)
  featuredUntil  DateTime?       @map("featured_until")
  published      Boolean         @default(false)
  publishedAt    DateTime?       @map("published_at")
  status         PropertyStatus  @default(DRAFT)
  createdByUserId String?        @map("created_by_user_id")
  createdByUser   User?          @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  images   PropertyImage[]
  leads    PropertyLead[]
  owners   PropertyOwner[]
  features PropertyFeature[]

  @@unique([tenantId, slug])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, published, publishedAt])
  @@index([tenantId, city, neighborhood])
  @@index([tenantId, purpose, price])
  @@index([tenantId, featured, published])
  @@index([tenantId, featured, featuredUntil])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0) @map("sort_order")
  isCover    Boolean  @default(false) @map("is_cover")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([propertyId, sortOrder])
  @@index([tenantId])
  @@map("property_images")
}

/// Interesse do portal público — não é o Lead do CRM
model PropertyLead {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  propertyId     String       @map("property_id")
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  message        String?
  source         String       @default("public_portal")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, propertyId])
  @@index([tenantId, createdAt])
  @@index([tenantId, businessUnitId])
  @@map("property_leads")
}

/// Pessoa do inventário imobiliário (não substitui Customer)
model Person {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       PersonKind @default(INDIVIDUAL)
  name       String
  document   String?
  email      String?
  phone      String?
  customerId String?    @unique @map("customer_id")
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  propertyOwners PropertyOwner[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("persons")
}

model PropertyOwner {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String   @map("property_id")
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  personId      String   @map("person_id")
  person        Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  isPrimary     Boolean  @default(false) @map("is_primary")
  publicVisible Boolean  @default(false) @map("public_visible")
  sharePercent  Decimal? @map("share_percent") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([propertyId, personId])
  @@index([tenantId, propertyId])
  @@index([personId])
  @@map("property_owners")
}

model PropertyFeatureDefinition {
  id        String                    @id @default(cuid())
  tenantId  String
  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  label     String
  valueType PropertyFeatureValueType  @default(BOOLEAN) @map("value_type")
  sortOrder Int                       @default(0) @map("sort_order")
  isActive  Boolean                   @default(true) @map("is_active")
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt

  values PropertyFeature[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("property_feature_definitions")
}

model PropertyFeature {
  id            String                     @id @default(cuid())
  tenantId      String
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String                     @map("property_id")
  property      Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  definitionId  String                     @map("definition_id")
  definition    PropertyFeatureDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  valueBoolean  Boolean?                   @map("value_boolean")
  valueText     String?                    @map("value_text")
  valueNumber   Decimal?                   @map("value_number") @db.Decimal(14, 2)
  createdAt     DateTime                   @default(now()) @map("created_at")

  @@unique([propertyId, definitionId])
  @@index([tenantId, propertyId])
  @@map("property_features")
}
