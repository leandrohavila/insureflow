{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_INTERNAL_URL",
    "API_URL",
    "AUTH_SECRET",
    "DATABASE_URL",
    "JWT_SECRET",
    "NEXT_PHASE",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_BUSINESS_UNIT_SLUG",
    "NEXT_PUBLIC_PORTAL_USE_MOCK",
    "NEXT_PUBLIC_TENANT_SLUG",
    "NODE_ENV",
    "DEAL_CONTRACT_DEBUG",
    "RUNTIME_AUDIT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@repo/forms-engine#build": {
      "outputs": ["dist/**"]
    },
    "@repo/forms-library#build": {
      "dependsOn": ["@repo/forms-engine#build"],
      "outputs": ["dist/**"]
    },
    "@repo/database#build": {
      "outputs": ["../../node_modules/.prisma/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
